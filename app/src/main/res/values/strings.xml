    <string name="design_madamada_desc">Japanese kanji from Chinese pinyin and katakana from English; mixed continuous typing of pinyin, English and romaji; whole-sentence conversion; readings on candidates; verb conjugation and keigo; categorized Japanese dictionaries; the vocabulary book; city themes</string>
    <string name="design_gboard">Gboard</string>
    <string name="design_gboard_desc">Layouts, touch interaction, the candidate bar, multilingual input, emoji, gesture typing, text field adaptation</string>
    <string name="design_mspinyin">Microsoft Pinyin</string>
    <string name="design_mspinyin_desc">Fuzzy pinyin, long-sentence conversion, frequency learning, double pinyin, the U and V modes, pinyin correction</string>
    <string name="design_sogou">Sogou Pinyin</string>
    <string name="design_sogou_desc">Smart prediction, long-sentence input, key correction, dictionary management, user-made words, candidate actions, keyboard skins</string>
    <string name="design_swiftkey">Microsoft SwiftKey</string>
    <string name="design_swiftkey_desc">Personalized and multilingual prediction, English correction, smart spacing, the clipboard, gestures</string>
    <string name="design_gji">Google Japanese Input and Mozc</string>
    <string name="design_gji_desc">Romaji conversion, kana–kanji and long-sentence conversion, bunsetsu conversion, Japanese dictionaries and prediction</string>
