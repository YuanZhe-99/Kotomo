<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="keystyle_section">按鍵與列</string>
    <string name="keystyle_gap">按鍵間距</string>
    <string name="keystyle_text">按鍵文字大小</string>
    <string name="keystyle_space">空白鍵寬度</string>
    <string name="keystyle_number_row">數字列</string>
    <string name="keystyle_number_row_desc">字母上方加一列數字</string>
    <string name="keystyle_mirrored">功能鍵放到另一側</string>
    <string name="keystyle_mirrored_desc">Enter、⇧ 與 ?123 移到對側，方便左手拇指</string>
    <string name="keystyle_long_press">自訂長按符號</string>
    <string name="keystyle_long_press_example">a=@á</string>
    <string name="keystyle_long_press_note">每行一個字母、一個等號和若干符號。第一個符號顯示在按鍵角落；字母的變音字元接在後面。</string>
    <string name="keystyle_floating_desc">鍵盤懸浮在 App 之上；拖動上方的橫條移動它</string>
    <string name="japanese_flick">12 鍵滑動輸入</string>
    <string name="japanese_flick_desc">在 12 鍵上輸入假名：點按輸入あ段，向左、上、右、下滑動輸入其他各段</string>
    <string name="chinese_idioms">成語補全</string>
    <string name="chinese_idioms_desc">打出成語的前幾個字後，提供後面的字。需要在「詞庫」中下載「成語」詞庫</string>
    <string name="chinese_strokes">按筆畫輸入罕用字</string>
    <string name="chinese_strokes_desc">先打 u，再按筆順打 h 一、s 丨、p 丿、n 丶、z 乙</string>
    <string name="chinese_quick">快速輸入</string>
    <string name="chinese_quick_desc">以 v 開頭：數字（v1234 → 一千二百三十四、金額大寫），vrq 日期，vsj 時間，vxq 星期，vu 加十六進位編碼輸入 Unicode 字元，或算式（v1+2*3）</string>
    <string name="chinese_quick_custom">自訂快速替換</string>
    <string name="chinese_quick_custom_example">dz=你的地址</string>
    <string name="chinese_quick_note">每行一個縮寫（字母與數字）、一個等號和替換文字；打 v 加縮寫即可。</string>
    <string name="double_pinyin">雙拼</string>
    <string name="double_full">全拼</string>
    <string name="double_microsoft">微軟</string>
    <string name="double_sogou">搜狗</string>
    <string name="double_xiaohe">小鶴</string>
    <string name="double_ziranma">自然碼</string>
    <string name="double_pinyin_note">每個音節兩個鍵：先聲母，後韻母。凡是打拼音的地方都適用，包括混合模式。微軟與搜狗用 ;（長按 b）打 ing。變更後中文資料會重新產生一會兒。</string>
</resources>
