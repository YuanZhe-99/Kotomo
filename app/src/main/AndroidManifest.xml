<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice typing (PLAN §12, ADR-015): asked for only when the person opens it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kotomo">

        <activity
            android:name=".settings.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The AI writing help: its own task, so closing it returns to the app being typed in. -->
        <activity
            android:name=".ai.AiActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/ai_title"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Shows only the system's microphone dialog for voice typing, then closes. -->
        <activity
            android:name=".ime.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ime.KotomoService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Deploys librime's data in its own process (PLAN §4.2). -->
        <service
            android:name=".backup.AutoSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".backup.AutoBackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".ime.RimeDeployService"
            android:exported="false"
            android:process=":deploy" />
    </application>

</manifest>
