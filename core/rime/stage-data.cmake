# Assembles librime's shared data directory for Kotomo: the luna_pinyin_simp schema with its
# dependencies, Kotomo's own schema patches and the OpenCC Traditional -> Simplified tables.
#
# Usage: cmake -DKOTOMO_ROOT=<repository> -DOUT=<directory> -P core/rime/stage-data.cmake
#
# Inputs:  KOTOMO_ROOT, the repository root (submodules checked out); OUT, the directory to fill.
# Side effects: creates OUT and writes files into it with LF line endings, rewriting a file only
#   when its content changed; nothing else is removed.
# Notes: no tool beyond CMake is needed, so it runs on Windows, Linux and macOS hosts. OpenCC's own
#   data build compiles .ocd2 files with its opencc_dict tool and Python; Kotomo ships the plain text
#   dictionaries instead, generates TSCharactersExt.txt the way OpenCC's script does and rewrites
#   t2s.json to reference them (OpenCC's "text" dictionary format).

cmake_minimum_required(VERSION 3.22)

if(NOT KOTOMO_ROOT OR NOT OUT)
  message(FATAL_ERROR "usage: cmake -DKOTOMO_ROOT=<repository> -DOUT=<directory> -P stage-data.cmake")
endif()

set(tp "${KOTOMO_ROOT}/third_party")
set(rime_files
  "${tp}/rime-prelude/default.yaml"
  "${tp}/rime-prelude/key_bindings.yaml"
  "${tp}/rime-prelude/punctuation.yaml"
  "${tp}/rime-prelude/symbols.yaml"
  "${tp}/rime-essay/essay.txt"
  "${tp}/rime-luna-pinyin/luna_pinyin.dict.yaml"
  "${tp}/rime-luna-pinyin/luna_pinyin.schema.yaml"
  "${tp}/rime-luna-pinyin/luna_pinyin_simp.schema.yaml"
  "${tp}/rime-luna-pinyin/pinyin.yaml"
  "${tp}/rime-stroke/stroke.dict.yaml"
  "${tp}/rime-stroke/stroke.schema.yaml"
  "${KOTOMO_ROOT}/core/rime/data/default.custom.yaml"
  "${KOTOMO_ROOT}/core/rime/data/luna_pinyin_simp.custom.yaml"
  "${KOTOMO_ROOT}/core/rime/data/luna_pinyin_simp_private.schema.yaml")
set(opencc_files
  "${tp}/opencc/data/dictionary/CJK_Compatibility_Ideographs.txt"
  "${tp}/opencc/data/dictionary/TSPhrases.txt"
  "${tp}/opencc/data/dictionary/TSCharacters.txt")

foreach(file IN LISTS rime_files opencc_files)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "missing ${file}; run `git submodule update --init` first")
  endif()
endforeach()

# Line endings: submodules ignore the repository's .gitattributes, so a Windows checkout with
# core.autocrlf has CRLF data, and CMake's file(READ)/file(WRITE) translate newlines on Windows.
# configure_file and file(CONFIGURE) with NEWLINE_STYLE LF write LF on every host, and rewrite a file
# only when its content changed, so unchanged data keeps its timestamp and librime does not rebuild
# it. @ONLY substitution would touch `@NAME@` sequences, so inputs containing one are refused.

# Copies text files into `destination` with LF line endings.
function(copy_lf destination)
  foreach(file IN LISTS ARGN)
    file(STRINGS "${file}" placeholders REGEX "@[A-Za-z0-9_]+@|#cmakedefine")
    if(placeholders)
      message(FATAL_ERROR "${file} contains an @NAME@ or #cmakedefine sequence")
    endif()
    get_filename_component(name "${file}" NAME)
    configure_file("${file}" "${destination}/${name}" @ONLY NEWLINE_STYLE LF)
  endforeach()
endfunction()

# Writes `content` to `path` with LF line endings.
function(write_lf path content)
  if(content MATCHES "@[A-Za-z0-9_]+@")
    message(FATAL_ERROR "${path} would contain an @NAME@ sequence")
  endif()
  file(CONFIGURE OUTPUT "${path}" CONTENT "${content}" @ONLY NEWLINE_STYLE LF)
endfunction()

file(MAKE_DIRECTORY "${OUT}/opencc")
copy_lf("${OUT}" ${rime_files})
copy_lf("${OUT}/opencc" ${opencc_files})

# TSCharactersExt.txt is generated by OpenCC's data/scripts/extract_tofu_risk.py: the mapping on the
# line after each `# @tofu-risk:` annotation in TSCharacters.txt, without the identity target.
# Config::NewFromFile loads it (librime does not ask OpenCC to skip tofu-risk dictionaries).
file(STRINGS "${OUT}/opencc/TSCharacters.txt" ts_lines ENCODING UTF-8)
set(ext "")
set(take_next FALSE)
foreach(line IN LISTS ts_lines)
  if(take_next)
    if(NOT line MATCHES "^([^\t]+)\t(.+)$")
      message(FATAL_ERROR "expected a mapping after @tofu-risk, got: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    string(REPLACE " " ";" values "${CMAKE_MATCH_2}")
    list(GET values 0 first)
    if(first STREQUAL key)
      list(REMOVE_AT values 0)
    endif()
    list(JOIN values " " values)
    string(APPEND ext "${key}\t${values}\n")
    set(take_next FALSE)
  elseif(line MATCHES "^# @tofu-risk:")
    set(take_next TRUE)
  endif()
endforeach()
write_lf("${OUT}/opencc/TSCharactersExt.txt" "${ext}")

# t2s.json references compiled .ocd2 dictionaries; point it at the text dictionaries.
file(READ "${tp}/opencc/data/config/t2s.json" t2s)
string(REPLACE "\r\n" "\n" t2s "${t2s}")
string(REPLACE "\"type\": \"ocd2\"" "\"type\": \"text\"" t2s "${t2s}")
string(REPLACE ".ocd2\"" ".txt\"" t2s "${t2s}")
if(t2s MATCHES "ocd2")
  message(FATAL_ERROR "t2s.json still references ocd2 dictionaries; its format changed upstream")
endif()
write_lf("${OUT}/opencc/t2s.json" "${t2s}")
