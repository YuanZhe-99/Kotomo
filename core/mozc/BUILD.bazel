# Kotomo's Mozc glue, built inside Mozc's Bazel workspace.
#
# scripts/build-mozc.sh copies third_party/mozc to a work directory and this
# directory to its src/kotomo, so this file is the BUILD of package //kotomo
# there; Mozc's own tree is never edited. The build passes
# --nocheck_visibility because several Mozc targets used here (//converter,
# //session:session_handler, //dictionary:dictionary_interface) are visible
# only to Mozc's own packages.

load("//:build_defs.bzl", "mozc_cc_binary", "mozc_cc_library", "mozc_cc_test", "mozc_select")
load("//android/jni:cross_build_binary.bzl", "cross_build_binary")

# The part of speech of every Mozc POS id (id.def's first six fields: POS, three
# subdivisions, conjugation type, conjugation form), for Describe (PLAN §10.1,
# §10.2). Generated from the same id.def the data set is built from, so the ids match.
genrule(
    name = "pos_names",
    srcs = ["//data/dictionary_oss:id.def"],
    outs = ["kotomo_pos_names.inc"],
    cmd = "awk '{ n = split($$2, f, \",\"); printf \"{%s, \\\"%s,%s,%s,%s,%s,%s\\\"},\\n\", $$1, f[1], f[2], f[3], f[4], f[5], f[6] }' $< > $@",
)

mozc_cc_library(
    name = "glue",
    srcs = [
        "kotomo_mozc.cc",
        "kotomo_mozc_api.cc",
        ":pos_names",
    ],
    hdrs = [
        "kotomo_mozc.h",
        "kotomo_mozc_api.h",
    ],
    deps = [
        "//base:system_util",
        "//base:util",
        "//composer",
        "//composer:table",
        "//config:config_handler",
        "//converter",
        "//converter:segments",
        "//data_manager",
        "//dictionary:dictionary_interface",
        "//dictionary:dictionary_token",
        "//dictionary:pos_matcher",
        "//engine",
        "//engine:modules",
        "//protocol:commands_cc_proto",
        "//protocol:config_cc_proto",
        "//request:conversion_request",
        "//session:session_handler",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_test(
    name = "kotomo_mozc_test",
    srcs = ["tests/kotomo_mozc_test.cc"],
    args = ["$(rootpath //data_manager/oss:mozc.data)"],
    data = ["//data_manager/oss:mozc.data"],
    deps = [
        ":glue",
        "@com_google_googletest//:gtest",
    ],
)

# A line service over the glue for host programs (the coordinator's host
# prototype in core/mixed); never part of the app.
mozc_cc_binary(
    name = "kotomo_mozc_service",
    srcs = ["kotomo_mozc_service.cc"],
    deps = [
        ":glue",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_library(
    name = "jni",
    srcs = ["kotomo_mozc_jni.cc"],
    # The NDK sysroot has jni.h; a host build takes it from the local JDK.
    deps = [
        ":glue",
        "//base:util",
    ] + mozc_select(
        android = [],
        default = ["@bazel_tools//tools/jdk:jni"],
    ),
    alwayslink = 1,
)

# libkotomo_mozc.so: 16 KB pages (Android 15+ requirement), JNI symbols only.
mozc_cc_binary(
    name = "libkotomo_mozc.so",
    additional_linker_inputs = ["exports.lds"],
    linkopts = [
        "-Wl,-z,max-page-size=16384",
        "-Wl,--version-script=$(location exports.lds)",
        "-Wl,--gc-sections",
        # lld exports the __start_/__stop_ bounds of protobuf's pb_defaults section unless told
        # otherwise; the version script cannot hide linker-made symbols.
        "-Wl,-z,start-stop-visibility=hidden",
    ],
    linkshared = 1,
    deps = [":jni"],
)

# Android ABIs, built with --config oss_android on the platforms Mozc defines
# for its own libmozc.so.
cross_build_binary(
    name = "android_arm64-v8a",
    cpu = "arm64-v8a",
    platform = "//android/jni:arm64-v8a",
    target = ":libkotomo_mozc.so",
)

cross_build_binary(
    name = "android_x86_64",
    cpu = "x86_64",
    platform = "//android/jni:x86_64",
    target = ":libkotomo_mozc.so",
)
